{
  "name": "outreach-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "rotate-key": "tsx scripts/rotate-key.ts"
  },
  "dependencies": {
    "@hapi/boom": "9.1.4",
    "@prisma/client": "6.16.2",
    "@types/pg": "8.15.5",
    "baileys": "6.7.24",
    "bcryptjs": "3.0.2",
    "libphonenumber-js": "1.12.10",
    "marked": "15.0.12",
    "next": "15.5.27",
    "nodemailer": "6.10.1",
    "pg": "8.23.1",
    "pg-boss": "10.3.2",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "1.5.5",
