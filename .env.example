# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://localhost:5432/outreach_dev
APP_BASE_URL=http://localhost:3000

# Unipile (from the Unipile dashboard). Ignored when UNIPILE_FAKE=true.
UNIPILE_FAKE=true
UNIPILE_DSN=apiXX.unipile.com:XXXXX
UNIPILE_API_KEY=
# Random 32+ chars each: openssl rand -hex 24
UNIPILE_WEBHOOK_SECRET=
UNIPILE_NOTIFY_SECRET=

# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# openssl rand -hex 32
RECONNECT_TOKEN_SECRET=
OTP_PEPPER=

# Email: Resend, or SMTP_*. EMAIL_DISABLED=true logs instead of sending (dev).
EMAIL_FROM=Outreach Team <alerts@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DISABLED=false
ADMIN_ALERT_EMAILS=a@example.com,b@example.com

# true = WhatsApp sends are logged, not sent (dev). The OTP is then shown on the page.
WA_DISABLED=false

# Seed creates/updates this SUPER_ADMIN (npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
